 pub use self::monitor::MonitorRenderElement;
 use self::monitor::{Monitor, WorkspaceSwitch};
 use self::workspace::{OutputId, Workspace};
+
+/// The monitors at the desks, by serial, as a meeting room can have the same model.
+const DESK_MONITOR_SERIALS: &[&str] = &[@deskSerials@];
+const LAPTOP_CONNECTOR: &str = "eDP-1";
+
+fn is_desk_monitor(output: &Output) -> bool {
+    output
+        .user_data()
+        .get::<niri_config::OutputName>()
+        .is_some_and(|name| name.serial.as_deref().is_some_and(|serial| DESK_MONITOR_SERIALS.contains(&serial)))
+}
+
+/// Moves all of the laptop's workspaces to the desk's monitor, which then shows and has the focus
+/// of what the laptop showed, and leaves the laptop on an empty one.
+fn dock_laptop<W: LayoutElement>(
+    monitors: &mut [Monitor<W>],
+    desk_idx: usize,
+    active_monitor_idx: &mut usize,
+) {
+    let Some(laptop_idx) = monitors
+        .iter()
+        .position(|mon| mon.output_name() == LAPTOP_CONNECTOR)
+    else {
+        return;
+    };
+
+    let laptop = &mut monitors[laptop_idx];
+    let shown = laptop.workspaces[laptop.active_workspace_idx].id();
+    let empty = laptop.workspaces.pop().unwrap();
+    let mut moved = mem::take(&mut laptop.workspaces);
+    laptop.workspaces.push(empty);
+    laptop.active_workspace_idx = 0;
+    laptop.previous_workspace_id = None;
+    laptop.workspace_switch = None;
+
+    moved.retain(|ws| ws.has_windows_or_name());
+    let desk = &mut monitors[desk_idx];
+    for ws in &mut moved {
+        ws.original_output = OutputId::new(&desk.output);
+    }
+    desk.append_workspaces(moved);
+    if let Some(idx) = desk.workspaces.iter().position(|ws| ws.id() == shown) {
+        desk.active_workspace_idx = idx;
+    }
+
+    *active_monitor_idx = desk_idx;
+}
