--- a/src/render_helpers/clipped_surface.rs
+++ b/src/render_helpers/clipped_surface.rs
@@ -198,6 +198,10 @@
         // Intersect with geometry, since we're clipping by it.
         let mut geo = self.geometry.to_physical_precise_round(scale);
         geo.loc -= self.geometry(scale).loc;
+        // A size that falls between two physical pixels leaves the last row and column unpainted,
+        // and an opaque claim over those keeps what is below from being drawn: they would be black.
+        geo.size.w = (geo.size.w - 1).max(0);
+        geo.size.h = (geo.size.h - 1).max(0);
         let regions = regions
             .into_iter()
             .filter_map(|rect| rect.intersection(geo));
