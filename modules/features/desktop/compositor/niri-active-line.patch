+    /// A light on the border under the window instead of a ring, as Weinig's EdgeLine draws one on
+    /// its frame's hairline: across the window, a line and a faint glow around it, both an odd
+    /// number of device pixels thick, fading out over the outer 35% at both ends. Its middle is the
+    /// window's last row of device pixels, inside the border, so that the glow falls on the window.
+    /// On whole device pixels. The shader holds a gradient's color past its end, so each takes two
+    /// halves. `alpha` is how lit it is.
+    pub fn update_line(&mut self, win_size: Size<f64, Logical>, scale: f64, alpha: f32) {
+        let tint = self.config.active_color;
+        let left_width = (win_size.w / 2. * scale).ceil() / scale;
+        let fade = win_size.w * 0.35;
+
+        for (i, (thickness, strength)) in [(2.5, 1.), (8., 0.22)].into_iter().enumerate() {
+            let across = 2. * (thickness * scale / 2.).floor() + 1.;
+            let y = (win_size.h * scale - 0.5 - across / 2.).round() / scale;
+            let height = across / scale;
+            let color = tint * strength;
+            let clear = color * 0.;
+
+            let halves = [
+                (0., left_width, 0., clear, color),
+                (left_width, win_size.w - left_width, win_size.w - fade, color, clear),
+            ];
+
+            for (j, (x, width, fade_x, from, to)) in halves.into_iter().enumerate() {
+                let part = i * 2 + j;
+                let size = Size::from((width, height));
+
+                self.locations[part] = Point::from((x, y));
+                self.buffers[part].resize(size);
+                self.buffers[part].set_color(color);
+                self.borders[part].update(
+                    size,
+                    Rectangle::new(Point::from((fade_x - x, 0.)), Size::from((fade, height))),
+                    GradientInterpolation::default(),
+                    from,
+                    to,
+                    0.,
+                    Rectangle::from_size(size),
+                    0.,
+                    CornerRadius::default(),
+                    scale as f32,
+                    alpha,
+                );
+            }
+        }
+    }
+
+    pub fn render_line(
+        &self,
+        renderer: &mut impl NiriRenderer,
+        location: Point<f64, Logical>,
+        push: &mut dyn FnMut(FocusRingRenderElement),
+    ) {
+        if self.config.off {
+            return;
+        }
+
+        let has_border_shader = BorderRenderElement::has_shader(renderer);
+
+        for part in 0..4 {
+            let location = location + self.locations[part];
+            let border = &self.borders[part];
+
+            push(if has_border_shader {
+                border.clone().with_location(location).into()
+            } else {
+                SolidColorRenderElement::from_buffer(
+                    &self.buffers[part],
+                    location,
+                    border.alpha(),
+                    Kind::Unspecified,
+                )
+                .into()
+            });
+        }
+    }
