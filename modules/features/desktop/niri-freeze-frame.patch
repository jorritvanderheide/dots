     /// Schedules an immediate redraw on all outputs if one is not already scheduled.
+    /// Keeps the outputs on their last frame until the windows have redrawn at their new size, so
+    /// that moving windows between outputs shows no frame with them half way.
+    pub fn freeze_frame(&mut self) {
+        let now = Instant::now();
+        let running = self.frame_freeze.is_some();
+        self.frame_freeze = Some(FrameFreeze {
+            ready_after: now + FRAME_FREEZE_MIN,
+            deadline: now + FRAME_FREEZE_MAX,
+        });
+        if running {
+            return;
+        }
+
+        self.event_loop
+            .insert_source(Timer::from_duration(FRAME_FREEZE_TICK), |_, _, state| {
+                state.niri.frame_freeze_tick()
+            })
+            .unwrap();
+    }
+
+    fn frame_freeze_tick(&mut self) -> TimeoutAction {
+        let Some(freeze) = &self.frame_freeze else {
+            return TimeoutAction::Drop;
+        };
+
+        let now = Instant::now();
+        let ready = now >= freeze.ready_after
+            && !self
+                .layout
+                .windows()
+                .any(|(_, mapped)| mapped.has_uncommitted_configure());
+        if ready || now >= freeze.deadline {
+            self.frame_freeze = None;
+            self.queue_redraw_all();
+            return TimeoutAction::Drop;
+        }
+
+        // Without renders no frame callbacks go out, and a client waiting for one could not commit
+        // its new size.
+        if let Some(output) = self.output_state.keys().next().cloned() {
+            let time = get_monotonic_time();
+            self.layout.with_windows_mut(|mapped, _| {
+                mapped.send_frame(&output, time, Some(FRAME_FREEZE_TICK), |_, _| None);
+            });
+        }
+
+        TimeoutAction::ToDuration(FRAME_FREEZE_TICK)
+    }
+
     pub fn queue_redraw_all(&mut self) {
         for state in self.output_state.values_mut() {
             state.redraw_state = mem::take(&mut state.redraw_state).queue_redraw();
