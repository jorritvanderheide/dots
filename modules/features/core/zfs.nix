{
  inputs,
  ...
}:
{
  flake.nixosModules.zfs =
    {
      config,
      ...
    }:
    {
      fileSystems."/persist".neededForBoot = true;

      # ZFS needs a stable, unique-enough hostId to refuse importing a pool
      # that wasn't cleanly exported (guards against two hosts touching the
      # same disk). Deriving it from the hostname keeps it reproducible from
      # the flake instead of a one-off value generated by hand at install time.
      networking.hostId = builtins.substring 0 8 (builtins.hashString "md5" config.networking.hostName);

      services.zfs.autoScrub.enable = true;

      boot = {
        supportedFilesystems = [ "zfs" ];

        # The root starts empty on every boot; preservation brings back what
        # is declared, from /persist.
        initrd.systemd.services.rollback = {
          before = [ "sysroot.mount" ];
          description = "Rollback ZFS root subvolume to pristine state";
          path = [ config.boot.zfs.package ];
          serviceConfig.Type = "oneshot";
          unitConfig.DefaultDependencies = "no";
          wantedBy = [ "initrd.target" ];

          after = [
            "systemd-cryptsetup@crypted.service"
            "zfs-import-zroot.service"
          ];

          script = ''
            zfs rollback -r zroot/root@empty
          '';
        };

        kernelParams =
          let
            facterReport = config.facter.report;
            memoryBytes = (builtins.head (builtins.head facterReport.hardware.memory).resources).range;
            # ZFS's ARC defaults to using up to ~half of RAM, which starves
            # everything else under memory pressure: the browser and editor
            # on a laptop, the databases and media services on a server. A
            # quarter is a safer cap.
            arcMaxBytes = memoryBytes / 4;
          in
          [
            # Hibernation needs swap large enough to hold all of RAM and
            # surviving a power cycle; this host only has zram swap
            # (kernel.nix), which is neither, so disable it outright rather
            # than risk a hibernate attempt failing badly. Suspend-to-RAM
            # (see desktop-shell.nix's idle.behavior.lock-and-suspend) is
            # unaffected.
            "nohibernate"
            "zfs.zfs_arc_max=${toString arcMaxBytes}"
          ];

        zfs = {
          devNodes = "/dev/disk/by-id/";
          forceImportAll = false;
          forceImportRoot = true;
          requestEncryptionCredentials = false;
        };
      };

      disko.devices.zpool.zroot =
        let
          diskInfo = (inputs.self.lib.mainDisk config.facter.report).info;
          diskSizeResource = builtins.head (builtins.filter (r: r.type == "size") diskInfo.resources);
          diskSize = builtins.floor (
            (diskSizeResource.value_1 * diskSizeResource.value_2) / (1024 * 1024 * 1024)
          );
        in
        {
          type = "zpool";

          datasets = {
            nix = {
              mountpoint = "/nix";
              postCreateHook = "zfs snapshot zroot/nix@empty";
              type = "zfs_fs";

              options = {
                atime = "off";
                canmount = "on";
                "com.sun:auto-snapshot" = "false";
                mountpoint = "legacy";
              };
            };

            persist = {
              mountpoint = "/persist";
              postCreateHook = "zfs set com.sun:auto-snapshot=false zroot/persist";
              type = "zfs_fs";

              options = {
                "com.sun:auto-snapshot" = "false";
                mountpoint = "legacy";
              };
            };

            reserved = {
              type = "zfs_fs";

              options = {
                canmount = "off";
                mountpoint = "none";
                reservation = "${toString (builtins.ceil (diskSize * 0.05))}G";
              };
            };

            root = {
              mountpoint = "/";
              postCreateHook = "zfs snapshot zroot/root@empty";
              type = "zfs_fs";

              options = {
                "com.sun:auto-snapshot" = "false";
                mountpoint = "legacy";
              };
            };
          };

          options = {
            ashift = "12";
            autotrim = "on";
          };

          rootFsOptions = {
            acltype = "posixacl";
            canmount = "off";
            checksum = "fletcher4";
            "com.sun:auto-snapshot" = "false";
            compression = "zstd";
            dnodesize = "auto";
            mountpoint = "none";
            normalization = "formD";
            relatime = "on";
            xattr = "sa";
          };
        };

      services.sanoid = {
        enable = true;

        datasets."zroot/persist" = {
          autoprune = true;
          autosnap = true;
          daily = 30;
          hourly = 24;

          # A laptop that's off/asleep for stretches doesn't accumulate
          # snapshots on a reliable cadence: monthly=3 meant a month away
          # could (and did) collapse coverage to almost nothing. Snapshots
          # are cheap (incremental), so keep deep history instead.
          monthly = 12;

          yearly = 2;
        };
      };

      # The pool's disks (ID_FS_TYPE zfs_member, labelled with the pool's
      # name) would show in Nautilus as a volume it can't mount; ZFS mounts
      # them itself.
      services.udev.extraRules = ''
        SUBSYSTEM=="block", ENV{ID_FS_TYPE}=="zfs_member", ENV{UDISKS_IGNORE}="1"
      '';
    };
}
